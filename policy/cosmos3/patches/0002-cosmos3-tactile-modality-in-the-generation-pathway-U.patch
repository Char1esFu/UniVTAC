+    # Tactile modality of the generation pathway (UniVTAC extension). Every stream of `tactile_keys` (images
+    # that are not cameras of the canvas) is encoded by the UniVTAC ResNet into one token per frame. The current
+    # frame is a clean condition; `tactile_future_steps` future frames, `tactile_future_stride` dataset frames
+    # apart (horizon stride * steps), are denoised together with the video and the actions. Tokens per sample:
+    # streams * (1 + steps). The tokens sit on the M-RoPE time axis at their frame times, so the tactile stride
+    # and horizon are independent of the video ones. 0 steps keeps the tactile modality as a condition only.
+    # `tactile_future_offsets` replaces stride and steps by explicit dataset frame offsets (e.g. denser near t).
+    tactile_keys: list[str] = field(default_factory=list)
+    tactile_history_offsets: list[int] = field(default_factory=lambda: [0])
+    tactile_future_stride: int = 5
+    tactile_future_steps: int = 6
+    tactile_future_offsets: list[int] | None = None
+    tactile_encoder_path: str | None = None  # UniVTAC checkpoint (best.pth)
+    tactile_backbone: str = "resnet18"
+    tactile_latent_dim: int = 512
+    tactile_input_size: tuple[int, int] = (224, 224)
+    # False: the encoder is frozen and gives the conditions and the targets. True: the encoder trains through
+    # the condition tokens and the targets come from an EMA copy (a target encoder trained by its own
+    # prediction loss could collapse), updated after every optimizer step with `tactile_ema_decay`.
+    tactile_encoder_trainable: bool = False
+    tactile_ema_decay: float = 0.999
+    tactile_loss_weight: float = 10.0
+    # Draw the tactile noise level separately, otherwise the tactile tokens share the noise level of the video.
+    independent_tactile_schedule: bool = False
+    tactile_time_distribution: TimeDistribution = "logitnormal"
+    tactile_training_shift: float = 1.0
     # Actions are zero padded to this width, the width of the action projections.
     max_action_dim: int = 64
     # Storage dtype of the parameters, except the modules kept in float32.
