+    def encode_tactile(self, tactile_images: Tensor | None, plan: SequencePlan, training: bool) -> Tensor | None:
+        """
+        The normalized tactile latents `[batch, frames, streams, tactile_latent_dim]` of the sequence plan: the
+        current frame from the encoder, the future frames from the target encoder in training and zero for
+        sampling (only the current frame is given).
+        """
+        if plan.tactile_condition_mask is None:
+            return None
+        if tactile_images is None:
+            raise ValueError(f"The batch has no tactile images for tactile_keys={self.config.tactile_keys}.")
+        num_frames = plan.tactile_condition_mask.shape[1]
+        current = self.network.encode_tactile(tactile_images[:, :1], target=False)  # [B,1,S,L]
+        if training:
+            if tactile_images.shape[1] != num_frames:
+                raise ValueError(f"Expected {num_frames} tactile frames, got {tactile_images.shape[1]}.")
+            future = self.network.encode_tactile(tactile_images[:, 1:], target=True)
+        else:
+            future = current.new_zeros(current.shape[0], num_frames - 1, *current.shape[2:])
+        return torch.cat([current, future], dim=1)
+
+    def tactile_loss(
+        self,
+        velocity: Tensor,
+        target: Tensor,
+        plan: SequencePlan,
+        future_valid: Tensor | None,
+        loss_mask: Tensor | None,
+    ) -> Tensor:
+        """
+        Mean squared velocity error over the noisy tactile tokens inside the episode and the latent channels,
+        per sample, averaged over the samples of `loss_mask`.
+        """
+        noisy = ~plan.tactile_condition_mask  # [B,T]
+        if future_valid is not None:
+            noisy = noisy.clone()
+            noisy[:, 1:] &= future_valid
+        error = ((velocity - target) ** 2).mean(dim=-1)  # [B,T,S]
+        weights = noisy[:, :, None].float().expand_as(error)
+        per_sample = (error * weights).sum(dim=(1, 2)) / weights.sum(dim=(1, 2)).clamp(min=1)
+        if loss_mask is None:
+            loss_mask = torch.ones_like(per_sample, dtype=torch.bool)
+        return per_sample.where(loss_mask, 0.0).sum() / loss_mask.sum().clamp(min=1)
 
